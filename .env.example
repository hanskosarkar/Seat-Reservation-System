# Copy to .env for local (non-docker) runs. Never commit .env.
DATABASE_URL=database-type://username:password@host:port/database-name
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=user-defined-algorithm
JWT_EXPIRY_MINUTES=1440

# asyncpg pool: keep max modest on free Postgres (low connection limits)
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_ACQUIRE_TIMEOUT_SECONDS=30
DB_COMMAND_TIMEOUT_SECONDS=30
DB_CONNECT_RETRIES=10

READY_CHECK_TIMEOUT_SECONDS=2
LOG_LEVEL=INFO
PORT=8000

MAX_SEATS_PER_SHOW=5000
